# SERV Reasoning (https://console.openserv.ai) — the intelligence layer behind every decision
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# Set to 1 to run SERV's shadow agent validation loop on every decision (slower, higher accuracy)
SERV_SHADOW_AGENT=0
# Optional RPC overrides (public endpoints are used by default)
ETH_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
# Daily quota on the shared SERV key (per visitor, signed cookie) and a soft global cap per server instance
ALLOC_DAILY_LIMIT=30
ALLOC_GLOBAL_DAILY_LIMIT=600
# Secret for signing the quota cookie (any long random string). Falls back to a hash of the SERV key.
ALLOC_QUOTA_SECRET=
# Set to 1 to disable the quota (local development)
ALLOC_QUOTA_OFF=
